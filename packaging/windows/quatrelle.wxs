<?xml version="1.0" encoding="utf-8"?>
<!--
  Quatrelle MSI (WiX Toolset v5: `dotnet tool install -g wix`). Built by package.ps1:

    wix build quatrelle.wxs -arch x64 -d Version=1.2.3 -d BinDir=... -d IconPath=... -o out.msi

  Per-machine install into Program Files, a Start Menu shortcut, and quatrelle.exe on the App
  Paths list (so Win+R `quatrelle` starts it). Quatrelle opens no file types yet, so it registers none.

  UpgradeCode is fixed for Quatrelle forever (playbook §6); never change it.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Name="Quatrelle"
      Manufacturer="Learning Machines LLC"
      Version="$(var.Version)"
      UpgradeCode="F1EC42C6-A525-406B-878C-789DC52E1958"
      Scope="perMachine"
      Compressed="yes"
      Language="1033">
    <SummaryInformation Description="Quatrelle email" Manufacturer="Learning Machines LLC" />
    <!-- Same-version upgrades let successive pre-releases of one X.Y.Z replace each other
         (MSI versions are numeric, so 1.2.3-rc.1 and 1.2.3-rc.2 are both 1.2.3). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
        DowngradeErrorMessage="A newer version of Quatrelle is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- Windows 10 or later: the Rust standard library has needed it since 1.78 (on Windows 7 and
         8 the app fails at launch: "The procedure entry point ProcessPrng could not be located in
         bcryptprimitives.dll"), and Quatrelle draws with DirectX 12. The installer says so rather
         than installing an app that can't start. `CurrentMajorVersionNumber` exists only from
         Windows 10 on, in the 32- and 64-bit registry views alike; MSI's own VersionNT has
         reported both 603 and 1000 there (as PhotoCraft found). `Installed` keeps repair and
         uninstall working on any Windows. -->
    <Property Id="WINDOWS10ORLATER" Secure="yes">
      <RegistrySearch Id="WindowsMajorVersion" Root="HKLM" Key="SOFTWARE\Microsoft\Windows NT\CurrentVersion"
          Name="CurrentMajorVersionNumber" Type="raw" />
    </Property>
    <Launch Condition="Installed OR WINDOWS10ORLATER" Message="Quatrelle needs Windows 10 or later." />

    <Icon Id="QuatrelleIcon.ico" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="QuatrelleIcon.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/dgaudin/quatrelle" />
    <Property Id="ARPURLUPDATEINFO" Value="https://github.com/dgaudin/quatrelle/releases" />
    <Property Id="ARPHELPLINK" Value="https://discord.gg/artcraft" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="Quatrelle" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <Feature Id="Main" Title="Quatrelle" Level="1">
      <ComponentGroupRef Id="QuatrelleFiles" />
    </Feature>
  </Package>

  <Fragment>
    <ComponentGroup Id="QuatrelleFiles" Directory="INSTALLFOLDER">
      <Component Id="QuatrelleApp" Guid="91B16AB2-5D6F-482D-B2D4-9886A392A893">
        <File Id="QuatrelleExe" Source="$(var.BinDir)\quatrelle.exe" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="Quatrelle"
              Description="Quatrelle email" WorkingDirectory="INSTALLFOLDER" Advertise="yes"
              Icon="QuatrelleIcon.ico" IconIndex="0">
            <!-- The app id Quatrelle's notifications are shown under (apps/quatrelle/src/toast.rs). -->
            <ShortcutProperty Key="System.AppUserModel.ID" Value="ai.storyteller.quatrelle" />
          </Shortcut>
        </File>
        <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\quatrelle.exe" Value="[#QuatrelleExe]" Type="string" />
      </Component>

      <Component Id="QuatrelleCli">
        <File Id="QuatrelleCliExe" Source="$(var.BinDir)\quatrelle-cli.exe" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
