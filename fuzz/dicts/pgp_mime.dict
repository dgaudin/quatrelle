# PGP/MIME (RFC 3156), inline PGP, Autocrypt and attached keys, in a message's header and parts.
"From: "
"Subject: "
"MIME-Version: 1.0"
"Content-Type: "
"Content-Transfer-Encoding: "
"Content-Disposition: attachment"
"multipart/signed"
"multipart/encrypted"
"multipart/mixed"
"text/plain"
"text/html"
"application/pgp-signature"
"application/pgp-encrypted"
"application/pgp-keys"
"application/octet-stream"
"protocol="
"boundary="
"charset="
"micalg=pgp-sha256"
"name=\"signature.asc\""
"name=\"encrypted.asc\""
"quoted-printable"
"base64"
"Version: 1"
"\x0d\x0a--b1\x0d\x0a"
"\x0d\x0a--b1--\x0d\x0a"
"\x0a--b1\x0a"
"-----BEGIN PGP MESSAGE-----"
"-----END PGP MESSAGE-----"
"-----BEGIN PGP SIGNED MESSAGE-----"
"-----BEGIN PGP SIGNATURE-----"
"-----END PGP SIGNATURE-----"
"-----BEGIN PGP PUBLIC KEY BLOCK-----"
"Autocrypt: addr="
"; keydata="
"prefer-encrypt=mutual"
"=3D"
